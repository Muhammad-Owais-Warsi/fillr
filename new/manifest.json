{
  "manifest_version": 3,
  "name": "Fillr",
  "version": "1.0",
  "description": "Type 'Ctrl + ;' in any input to trigger a snippet autocomplete menu.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
